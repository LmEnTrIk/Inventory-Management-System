<Window x:Class="InventoryApp.Views.PartEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="460" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />

            <TextBlock Text="SKU *" Style="{StaticResource FieldLabel}" />
            <TextBox Margin="0,0,0,22" MaxLength="50"
                     Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Name *" Style="{StaticResource FieldLabel}" />
            <TextBox Margin="0,0,0,22" MaxLength="150"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Category *" Style="{StaticResource FieldLabel}" />
            <ComboBox Margin="0,0,0,22" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCategory}" />

            <TextBlock Text="Unit price *" Style="{StaticResource FieldLabel}" />
            <TextBox Margin="0,0,0,22"
                     Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource FieldLabel}">
                <Run Text="Quantity in stock *" />
                <Run Text="(use Stock Movement to change)" FontWeight="Normal"
                     Foreground="{StaticResource MutedTextBrush}" />
            </TextBlock>
            <TextBox Margin="0,0,0,22" IsReadOnly="{Binding IsEdit}"
                     Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Minimum threshold (low stock alert) *" Style="{StaticResource FieldLabel}" />
            <TextBox Margin="0,0,0,22"
                     Text="{Binding MinThresholdText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource ServerErrorText}" Text="{Binding ServerError}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Save" IsDefault="True" Style="{StaticResource AccentButton}" Margin="0"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
