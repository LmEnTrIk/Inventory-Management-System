<Window x:Class="InventoryApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Management System" Width="1180" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- Summary statistics bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Total Items: " />
                <TextBlock FontWeight="SemiBold" Text="{Binding TotalItems}" Margin="0,0,32,0" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Total Inventory Value: " />
                <TextBlock FontWeight="SemiBold" Text="{Binding TotalInventoryValue, StringFormat={}{0:C2}}"
                           Margin="0,0,32,0" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Low Stock Alerts: " />
                <TextBlock FontWeight="SemiBold" Text="{Binding LowStockAlerts}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LowStockAlerts}" Value="0">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Toolbar: search, filters and actions -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="False" IsEnabled="{Binding IsIdle}">
                <TextBox DockPanel.Dock="Left" Width="260" Margin="0,0,12,0"
                         ToolTip="Search by name or SKU"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox DockPanel.Dock="Left" Width="180" Margin="0,0,12,0"
                          ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCategory}" />
                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="Low Stock Only"
                          IsChecked="{Binding LowStockOnly}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                    <Button Content="Stock Movement" Command="{Binding RegisterMovementCommand}" />
                    <Button Content="Delete" Style="{StaticResource DangerButton}"
                            Command="{Binding DeletePartCommand}" />
                    <Button Content="Edit" Command="{Binding EditPartCommand}" />
                    <Button Content="+ Add Part" Style="{StaticResource AccentButton}" Margin="0"
                            Command="{Binding AddPartCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Data grid with loading overlay -->
        <Grid Margin="16">
            <DataGrid x:Name="PartsGrid" ItemsSource="{Binding PartsView}"
                      SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                      IsEnabled="{Binding IsIdle}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Width="140" Binding="{Binding Sku}" />
                    <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Category" Width="160" Binding="{Binding CategoryName}" />
                    <DataGridTextColumn Header="Price" Width="110" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Quantity" Width="100" SortMemberPath="QuantityInStock">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding QuantityInStock}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Foreground" Value="#991B1B" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Min" Width="70" Binding="{Binding MinThreshold}" />
                    <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Left"
                                        Background="#DCFCE7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#166534" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Foreground" Value="#991B1B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading overlay -->
            <Border Background="#99FFFFFF"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="220">
                    <TextBlock Text="Loading..." HorizontalAlignment="Center" Margin="0,0,0,8"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <ProgressBar IsIndeterminate="True" Height="6" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
